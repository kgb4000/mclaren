# PostHog browser analytics configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_ID=your_posthog_project_id

# PostHog server-side analytics query API (server-only — do not prefix with NEXT_PUBLIC_)
POSTHOG_PERSONAL_API_KEY=

# Admin area auth (server-only — do not prefix with NEXT_PUBLIC_)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
